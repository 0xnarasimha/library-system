<script>
  function triggerNavAction(name) {
    console.log(`[PyLibAnalytics] Navigating to: ${name}`);
    const notification = document.createElement('div');
    notification.className = 'fixed bottom-10 left-1/2 -translate-x-1/2 px-6 py-3 rounded-full apple-glass border border-[#ffd085]/40 shadow-2xl text-xs font-mono text-[#fbf8ee] font-semibold flex items-center gap-2 z-50 transition-all';
    notification.innerHTML = `<span class="w-2 h-2 rounded-full bg-[#ffd085] animate-ping"></span> Route Active: ${name} Telemetry Node`;
    document.body.appendChild(notification);
    setTimeout(() => {
      notification.style.opacity = '0';
      setTimeout(() => notification.remove(), 400);
    }, 1800);
  }

  function selectTimeframe(btn, frame) {
    document.querySelectorAll('.timeframe-btn').forEach(b => {
      b.className = 'px-3 py-1 rounded-full text-[#b5b8ad] hover:text-[#fbf8ee] transition timeframe-btn';
    });
    btn.className = 'px-3.5 py-1 rounded-full bg-white/20 text-[#ffd085] font-bold shadow-sm timeframe-btn';
    console.log(`[PyLibAnalytics] Switched timeframe: ${frame}`);
  }

  function refreshTelemetryPulse() {
    const throttleEl = document.getElementById('hero-throttle');
    if (throttleEl) {
      throttleEl.textContent = '99.98% TPS';
      setTimeout(() => {
        throttleEl.textContent = '98.47% TPS';
      }, 900);
    }
  }

  function filterEventLog(query) {
    const filter = query.toUpperCase();
    const rows = document.getElementById('event-log-tbody').getElementsByTagName('tr');
    for (let i = 0; i < rows.length; i++) {
      const text = rows[i].textContent || rows[i].innerText;
      if (text.toUpperCase().indexOf(filter) > -1) {
        rows[i].style.display = '';
      } else {
        rows[i].style.display = 'none';
      }
    }
  }

  (function() {
    const cycleTimerEl = document.getElementById('hero-cycle-timer');
    const throttleEl = document.getElementById('hero-throttle');
    let ms = 18420;

    // Sub-second precision cycle counter
    setInterval(() => {
      ms += 41;
      const seconds = Math.floor((ms % 60000) / 1000);
      const remainingMs = ms % 1000;
      if (cycleTimerEl) {
        cycleTimerEl.textContent = `00:${seconds < 10 ? '0' : ''}${seconds}.${remainingMs < 100 ? (remainingMs < 10 ? '00' : '0') : ''}${remainingMs}s`;
      }
    }, 41);

    // Subtle TPS telemetry jitter
    setInterval(() => {
      if (throttleEl && throttleEl.textContent !== '99.98% TPS') {
        const jitter = (98.1 + Math.random() * 0.8).toFixed(2);
        throttleEl.textContent = `${jitter}% TPS`;
      }
    }, 950);
  })();
</script>
